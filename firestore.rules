rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/familyMembers/$(familyId + '_' + request.auth.uid)) &&
         get(/databases/$(database)/documents/familyMembers/$(familyId + '_' + request.auth.uid)).data.status == 'active') ||
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid)
      );
    }

    function isFamilyAdminOrOwner(familyId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/familyMembers/$(familyId + '_' + request.auth.uid)) &&
         get(/databases/$(database)/documents/familyMembers/$(familyId + '_' + request.auth.uid)).data.role in ['owner', 'admin'] &&
         get(/databases/$(database)/documents/familyMembers/$(familyId + '_' + request.auth.uid)).data.status == 'active') ||
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid)
      );
    }

    function isFamilyOwner(familyId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/familyMembers/$(familyId + '_' + request.auth.uid)) &&
         get(/databases/$(database)/documents/familyMembers/$(familyId + '_' + request.auth.uid)).data.role == 'owner' &&
         get(/databases/$(database)/documents/familyMembers/$(familyId + '_' + request.auth.uid)).data.status == 'active') ||
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid)
      );
    }

    // --- Users Collection (Authenticated users can read profiles, owner can create or update) ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // --- Families Collection ---
    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && isFamilyAdminOrOwner(familyId) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.id == resource.data.id;
      allow delete: if isAuthenticated() && isFamilyOwner(familyId);

      // --- Member Profiles Subcollection ---
      match /memberProfiles/{memberId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          request.resource.data.userId == request.auth.uid
        ) && request.resource.data.familyId == familyId;
        allow update: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          (resource.data.userId != null && resource.data.userId == request.auth.uid)
        ) && request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
      }

      // --- Members Subcollection (alias for memberProfiles) ---
      match /members/{memberId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          request.resource.data.userId == request.auth.uid
        ) && request.resource.data.familyId == familyId;
        allow update: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          (resource.data.userId != null && resource.data.userId == request.auth.uid)
        ) && request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
      }

      // --- Children & School Subcollection ---
      match /children/{childId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyAdminOrOwner(familyId) && request.resource.data.familyId == familyId;
        allow update: if isAuthenticated() && isFamilyAdminOrOwner(familyId) && request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);

        match /guardians/{guardianId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }

        match /fees/{feeId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow create: if isAuthenticated() && isFamilyMember(familyId);
          allow update, delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }

        match /documents/{docId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow create: if isAuthenticated() && isFamilyMember(familyId);
          allow update, delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }
      }

      // --- Medical Profiles Subcollection ---
      match /medicalProfiles/{profileId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyAdminOrOwner(familyId) && request.resource.data.familyId == familyId;
        allow update: if isAuthenticated() && isFamilyAdminOrOwner(familyId) && request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);

        match /allergies/{allergyId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }

        match /conditions/{conditionId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }

        match /medicines/{medicineId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }

        match /doctors/{doctorId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }

        match /documents/{docId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }
      }

      // --- Medical Appointments Subcollection ---
      match /medicalAppointments/{appointmentId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
      }

      // --- Special Care Profiles Subcollection ---
      match /specialCare/{careProfileId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyAdminOrOwner(familyId) && request.resource.data.familyId == familyId;
        allow update: if isAuthenticated() && isFamilyAdminOrOwner(familyId) && request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);

        match /needs/{needId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }

        match /routines/{routineId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
        }

        match /tasks/{taskId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyMember(familyId);
        }
      }

      // --- Family Expenses Subcollection ---
      match /expenses/{expenseId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == resource.data.familyId &&
          request.resource.data.createdBy == resource.data.createdBy &&
          (
            isFamilyAdminOrOwner(familyId) ||
            resource.data.createdBy == request.auth.uid
          );
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.createdBy == request.auth.uid
        );
      }

      // --- Expense Categories Subcollection ---
      match /expenseCategories/{categoryId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) && request.resource.data.familyId == familyId;
        allow update, delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
      }

      // --- Monthly Budgets Subcollection ---
      match /budgets/{budgetId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create, update, delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId) && request.resource.data.familyId == familyId;
      }

      // --- Bills Management Subcollection ---
      match /bills/{billId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) && request.resource.data.familyId == familyId;
        allow update: if isAuthenticated() && isFamilyMember(familyId) && request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.createdBy == request.auth.uid
        );

        match /payments/{paymentId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyMember(familyId);
        }

        match /documents/{docId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyMember(familyId);
        }
      }

      // --- Bill Templates Subcollection (Recurring) ---
      match /billTemplates/{templateId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow write: if isAuthenticated() && isFamilyMember(familyId);
      }

      // --- Bill Types Subcollection ---
      match /billTypes/{typeId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId);
        allow update, delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
      }

      // --- Family Notes & Urgent Needs Subcollection ---
      match /notes/{noteId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == resource.data.familyId &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.createdBy == request.auth.uid
        );

        match /attachments/{attachmentId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyMember(familyId);
        }
      }

      // --- Note Categories Subcollection ---
      match /noteCategories/{categoryId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId);
        allow update, delete: if isAuthenticated() && isFamilyAdminOrOwner(familyId);
      }

      // --- Family Information Center Subcollection ---
      match /information/{informationId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == resource.data.familyId &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.createdBy == request.auth.uid
        );

        match /attachments/{attachmentId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyMember(familyId);
        }
      }

      // --- Photo Albums & Photos Subcollections ---
      match /albums/{albumId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == resource.data.familyId &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.createdBy == request.auth.uid
        );

        match /photos/{photoId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow create: if isAuthenticated() && isFamilyMember(familyId) &&
            request.resource.data.familyId == familyId &&
            request.resource.data.uploadedBy == request.auth.uid;
          allow update: if isAuthenticated() && isFamilyMember(familyId) &&
            request.resource.data.familyId == resource.data.familyId &&
            request.resource.data.uploadedBy == resource.data.uploadedBy;
          allow delete: if isAuthenticated() && (
            isFamilyAdminOrOwner(familyId) ||
            resource.data.uploadedBy == request.auth.uid
          );
        }
      }

      // --- Personal Photo Favorites Subcollection ---
      match /photoFavorites/{favoriteId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.familyId == familyId;
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // --- Family Events & Planner Subcollection ---
      match /events/{eventId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == resource.data.familyId &&
          (
            isFamilyAdminOrOwner(familyId) ||
            resource.data.createdBy == request.auth.uid
          );
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.createdBy == request.auth.uid
        );

        match /attachments/{attachmentId} {
          allow read: if isAuthenticated() && isFamilyMember(familyId);
          allow write: if isAuthenticated() && isFamilyMember(familyId);
        }
      }

      // --- Family Reminders Subcollection ---
      match /reminders/{reminderId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.createdBy == request.auth.uid
        );
      }

      // --- Family AI Conversations Subcollection ---
      match /aiConversations/{conversationId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.createdBy == request.auth.uid
        );
      }

      // --- Family Documents Subcollection ---
      match /documents/{documentId} {
        allow read: if isAuthenticated() && isFamilyMember(familyId);
        allow create: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId;
        allow update: if isAuthenticated() && isFamilyMember(familyId) &&
          request.resource.data.familyId == resource.data.familyId;
        allow delete: if isAuthenticated() && (
          isFamilyAdminOrOwner(familyId) ||
          resource.data.uploadedById == request.auth.uid
        );
      }
    }

    // --- Family Memberships Collection ---
    match /familyMembers/{membershipId} {
      allow read: if isAuthenticated();

      // Creation:
      // A user can create their own membership (creating family or joining),
      // OR a family admin/owner can add a member.
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isFamilyAdminOrOwner(request.resource.data.familyId)
      );

      // Updates: Identity and familyId are strictly immutable
      allow update: if isAuthenticated() &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.userId == resource.data.userId &&
        (
          // User updating their own profile/status without modifying role
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'userName', 'userPhoto'])
          ) ||
          // Family Admin or Owner updating roles/status
          (
            isFamilyAdminOrOwner(resource.data.familyId) &&
            (request.resource.data.role != 'owner' || isFamilyOwner(resource.data.familyId))
          )
        );

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isFamilyAdminOrOwner(resource.data.familyId)
      );
    }

    // --- Family Invitations ---
    match /familyInvites/{inviteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.invitedBy == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isFamilyAdminOrOwner(resource.data.familyId);
    }

    // --- Chat Rooms ---
    match /chatRooms/{chatRoomId} {
      allow get, list: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        isFamilyMember(request.resource.data.familyId)
      );
      allow update, delete: if isAuthenticated() && isFamilyAdminOrOwner(resource.data.familyId);

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        allow get, list: if isAuthenticated() &&
          isFamilyMember(get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.familyId);
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.chatRoomId == chatRoomId &&
          isFamilyMember(get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.familyId) &&
          request.resource.data.familyId == get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.familyId;
        allow update: if isAuthenticated() &&
          isFamilyMember(get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.familyId) &&
          request.resource.data.chatRoomId == resource.data.chatRoomId &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.familyId == resource.data.familyId &&
          (
            resource.data.senderId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'isPinned', 'pinnedBy', 'pinnedAt'])
          );
        allow delete: if isAuthenticated() &&
          isFamilyMember(get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.familyId) &&
          (
            resource.data.senderId == request.auth.uid ||
            isFamilyAdminOrOwner(get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.familyId)
          );
      }

      // --- Typing Indicators ---
      match /typing/{userId} {
        allow read: if isAuthenticated() && isFamilyMember(get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.familyId);
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // --- Chat Members ---
    match /chatMembers/{chatMemberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isFamilyAdminOrOwner(request.resource.data.familyId)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isFamilyAdminOrOwner(resource.data.familyId)
      );
    }

    // --- Chat Read States ---
    match /chatReadStates/{readStateId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isFamilyMember(resource.data.familyId)
      );
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow get, list: if isAuthenticated() && resource.data.recipientUserId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.recipientUserId != null &&
        (request.resource.data.familyId == null || isFamilyMember(request.resource.data.familyId));
      allow update: if isAuthenticated() &&
        resource.data.recipientUserId == request.auth.uid &&
        request.resource.data.recipientUserId == resource.data.recipientUserId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if isAuthenticated() && resource.data.recipientUserId == request.auth.uid;
    }

    // --- Activity Logs ---
    match /activityLogs/{activityId} {
      allow get, list: if isAuthenticated() && (
        resource.data.actorUserId == request.auth.uid ||
        isFamilyMember(resource.data.familyId)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.actorUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Strictly Private Personal Records (ownerId partitioned) ---
    match /personalExpenses/{expenseId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalNotes/{noteId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalTasks/{taskId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalSchoolWork/{itemId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalNeeds/{needId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalPlans/{planId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalReminders/{reminderId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalFiles/{fileId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalPhotos/{photoId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalAlbums/{albumId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /personalAIConversations/{convId} {
      allow get, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // --- Test connection document ---
    match /test/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
