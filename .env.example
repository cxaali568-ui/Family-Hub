# GEMINI_API_KEY: Required for Gemini AI API calls.
# Server-side environment variable. Configure via Secrets or server env.
GEMINI_API_KEY="your_gemini_api_key_here"

# OPENAI_API_KEY: Required for ChatGPT / OpenAI API calls.
# Server-side environment variable. NEVER expose to frontend.
OPENAI_API_KEY="your_openai_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional overrides; defaults to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
