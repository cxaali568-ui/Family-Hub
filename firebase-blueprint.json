{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing basic account metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "fullName": { "type": "string", "description": "Full display name" },
        "email": { "type": "string", "description": "Primary email" },
        "phone": { "type": "string", "description": "Optional phone number" },
        "profileImage": { "type": "string", "description": "Avatar photo URL" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "updatedAt": { "type": "string", "description": "Profile update timestamp" },
        "lastLoginAt": { "type": "string", "description": "Last sign in timestamp" },
        "status": { "type": "string", "description": "Online presence status", "enum": ["online", "away", "offline"] }
      },
      "required": ["id", "fullName", "email", "createdAt"]
    },
    "Family": {
      "title": "Family",
      "description": "Core family unit document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique family identifier" },
        "name": { "type": "string", "description": "Name of the family" },
        "photo": { "type": "string", "description": "Family cover or avatar photo URL" },
        "createdBy": { "type": "string", "description": "User ID of creator/owner" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" },
        "status": { "type": "string", "description": "Family space status", "enum": ["active", "archived"] }
      },
      "required": ["id", "name", "createdBy", "createdAt"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "Join document linking a user to a family with role permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique membership record ID" },
        "familyId": { "type": "string", "description": "Family reference ID" },
        "userId": { "type": "string", "description": "User reference ID" },
        "role": { "type": "string", "description": "Role in this family", "enum": ["owner", "admin", "member"] },
        "status": { "type": "string", "description": "Membership status", "enum": ["active", "pending", "removed"] },
        "joinedAt": { "type": "string", "description": "Timestamp when joined" },
        "updatedAt": { "type": "string", "description": "Timestamp when role or status changed" }
      },
      "required": ["id", "familyId", "userId", "role", "status", "joinedAt"]
    },
    "FamilyInvite": {
      "title": "FamilyInvite",
      "description": "Invitation record containing an unguessable invitation code",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique invite ID" },
        "familyId": { "type": "string", "description": "Target family ID" },
        "familyName": { "type": "string", "description": "Name of the target family" },
        "invitedBy": { "type": "string", "description": "User ID of the inviter" },
        "inviteCode": { "type": "string", "description": "Secure unguessable code e.g. FAM-8K4P-29XQ" },
        "email": { "type": "string", "description": "Optional invited email" },
        "role": { "type": "string", "description": "Assigned role upon joining", "enum": ["admin", "member"] },
        "status": { "type": "string", "description": "Invite state", "enum": ["pending", "accepted", "expired", "cancelled"] },
        "expiresAt": { "type": "string", "description": "Expiration timestamp" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "familyId", "invitedBy", "inviteCode", "role", "status", "createdAt"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Chat room within a family",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Chat room ID" },
        "familyId": { "type": "string", "description": "Associated family ID" },
        "type": { "type": "string", "description": "Room type", "enum": ["family", "channel", "direct"] },
        "name": { "type": "string", "description": "Name of the room" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "createdBy": { "type": "string", "description": "User ID of creator" }
      },
      "required": ["id", "familyId", "type", "name", "createdAt"]
    },
    "ChatMember": {
      "title": "ChatMember",
      "description": "Relationship linking user to a chat room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Membership ID" },
        "chatRoomId": { "type": "string", "description": "Chat room ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "userId": { "type": "string", "description": "User ID" },
        "joinedAt": { "type": "string", "description": "Joined timestamp" },
        "status": { "type": "string", "description": "Membership status", "enum": ["active", "left"] }
      },
      "required": ["id", "chatRoomId", "userId", "joinedAt", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app alerts for users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "recipientUserId": { "type": "string", "description": "Target user ID" },
        "familyId": { "type": "string", "description": "Optional family ID context" },
        "type": { "type": "string", "description": "Type of alert" },
        "title": { "type": "string", "description": "Short headline" },
        "message": { "type": "string", "description": "Body message" },
        "relatedEntityType": { "type": "string", "description": "Entity kind" },
        "relatedEntityId": { "type": "string", "description": "Entity ID" },
        "createdAt": { "type": "string", "description": "Timestamp" },
        "readAt": { "type": "string", "description": "Read timestamp or null" }
      },
      "required": ["id", "recipientUserId", "type", "title", "message", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail of household actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Activity log ID" },
        "familyId": { "type": "string", "description": "Target family ID" },
        "actorUserId": { "type": "string", "description": "Actor user ID" },
        "actorName": { "type": "string", "description": "Actor display name" },
        "action": { "type": "string", "description": "Action performed" },
        "entityType": { "type": "string", "description": "Entity affected" },
        "entityId": { "type": "string", "description": "Entity ID" },
        "createdAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["id", "familyId", "actorUserId", "actorName", "action", "entityType", "createdAt"]
    },
    "PersonalExpense": {
      "title": "PersonalExpense",
      "description": "Private expense belonging strictly to ownerId",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Expense ID" },
        "ownerId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Description" },
        "amount": { "type": "number", "description": "Amount in currency" },
        "category": { "type": "string", "description": "Category" },
        "date": { "type": "string", "description": "Date" }
      },
      "required": ["id", "ownerId", "title", "amount", "date"]
    },
    "PersonalNote": {
      "title": "PersonalNote",
      "description": "Private journal or note belonging strictly to ownerId",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Note ID" },
        "ownerId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Note title" },
        "content": { "type": "string", "description": "Note content" },
        "category": { "type": "string", "description": "Category" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["id", "ownerId", "title", "content", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time family message document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "chatRoomId": { "type": "string", "description": "Chat room ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "senderId": { "type": "string", "description": "User ID of sender" },
        "senderName": { "type": "string", "description": "Display name of sender" },
        "senderPhoto": { "type": "string", "description": "Avatar URL of sender" },
        "text": { "type": "string", "description": "Text content" },
        "type": { "type": "string", "description": "Message type", "enum": ["text", "image", "file", "system"] },
        "createdAt": { "type": "string", "description": "Timestamp" },
        "updatedAt": { "type": "string", "description": "Updated timestamp" },
        "editedAt": { "type": "string", "description": "Timestamp if edited" },
        "deletedAt": { "type": "string", "description": "Timestamp if deleted" },
        "replyToMessageId": { "type": "string", "description": "Parent message ID if reply" }
      },
      "required": ["id", "chatRoomId", "familyId", "senderId", "senderName", "type", "createdAt"]
    },
    "ChatReadState": {
      "title": "ChatReadState",
      "description": "Tracks the last read message per user per room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Format: {chatRoomId}_{userId}" },
        "chatRoomId": { "type": "string", "description": "Chat room ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "userId": { "type": "string", "description": "User ID" },
        "lastReadMessageId": { "type": "string", "description": "ID of last read message" },
        "lastReadAt": { "type": "string", "description": "Timestamp of read" }
      },
      "required": ["id", "chatRoomId", "userId", "lastReadAt"]
    },
    "TypingState": {
      "title": "TypingState",
      "description": "Temporary typing presence in chat room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID" },
        "chatRoomId": { "type": "string", "description": "Chat room ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "userId": { "type": "string", "description": "User ID" },
        "userName": { "type": "string", "description": "User name" },
        "updatedAt": { "type": "string", "description": "Heartbeat timestamp" }
      },
      "required": ["id", "chatRoomId", "userId", "userName", "updatedAt"]
    },
    "FamilyMemberProfile": {
      "title": "FamilyMemberProfile",
      "description": "Individual profile of a family member (adult, child, elderly)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Profile ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "userId": { "type": "string", "description": "Optional linked user ID" },
        "fullName": { "type": "string", "description": "Member full name" },
        "nickname": { "type": "string", "description": "Optional nickname" },
        "relationship": { "type": "string", "description": "Relationship to family" },
        "gender": { "type": "string", "description": "Gender" },
        "dateOfBirth": { "type": "string", "description": "Date of birth" },
        "phone": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email address" },
        "isChild": { "type": "boolean", "description": "Whether member is a child" },
        "status": { "type": "string", "description": "Status" }
      },
      "required": ["id", "familyId", "fullName", "relationship"]
    },
    "Child": {
      "title": "Child",
      "description": "Child profile with school and tuition management",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Child ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "fullName": { "type": "string", "description": "Child full name" },
        "schoolName": { "type": "string", "description": "School name" },
        "classGrade": { "type": "string", "description": "Class or grade" },
        "tuitionFee": { "type": "number", "description": "Tuition fee" },
        "totalMonthlyFee": { "type": "number", "description": "Total monthly fee" }
      },
      "required": ["id", "familyId", "fullName", "dateOfBirth"]
    },
    "ChildGuardian": {
      "title": "ChildGuardian",
      "description": "Guardian relationship for a child",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Guardian record ID" },
        "childId": { "type": "string", "description": "Child ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "memberName": { "type": "string", "description": "Guardian name" },
        "relationship": { "type": "string", "description": "Guardian relationship" }
      },
      "required": ["id", "childId", "familyId", "memberName", "relationship"]
    },
    "SchoolFeePayment": {
      "title": "SchoolFeePayment",
      "description": "Monthly fee payment entry for child",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Fee payment ID" },
        "childId": { "type": "string", "description": "Child ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "month": { "type": "string", "description": "Month" },
        "amount": { "type": "number", "description": "Amount paid" },
        "status": { "type": "string", "description": "Payment status" }
      },
      "required": ["id", "childId", "familyId", "month", "amount", "status"]
    },
    "ChildDocument": {
      "title": "ChildDocument",
      "description": "Document record attached to a child profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "childId": { "type": "string", "description": "Child ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "title": { "type": "string", "description": "Document title" },
        "url": { "type": "string", "description": "File URL" }
      },
      "required": ["id", "childId", "familyId", "title", "url"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Family household expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique expense record ID" },
        "familyId": { "type": "string", "description": "Family ID reference" },
        "amount": { "type": "number", "description": "Expense numeric amount" },
        "amountMinor": { "type": "number", "description": "Integer minor units for safe arithmetic" },
        "currency": { "type": "string", "description": "Currency code e.g. PKR" },
        "categoryId": { "type": "string", "description": "Expense category identifier" },
        "categoryName": { "type": "string", "description": "Expense category title" },
        "categoryIcon": { "type": "string", "description": "Category icon name or emoji" },
        "expenseDate": { "type": "string", "description": "Expense date YYYY-MM-DD" },
        "expenseTime": { "type": "string", "description": "Expense time HH:MM optional" },
        "monthKey": { "type": "string", "description": "Standard month key YYYY-MM" },
        "year": { "type": "number", "description": "Calendar year" },
        "month": { "type": "number", "description": "Month number 1-12" },
        "description": { "type": "string", "description": "Expense description or item title" },
        "paidByMemberId": { "type": "string", "description": "Family member who paid" },
        "paidByName": { "type": "string", "description": "Display name of payer" },
        "forMemberId": { "type": "string", "description": "Beneficiary family member or 'Family'" },
        "forPersonName": { "type": "string", "description": "Display name of person expense was for" },
        "paymentMethod": { "type": "string", "description": "Method of payment e.g. Cash, Card" },
        "receiptPath": { "type": "string", "description": "Private storage path of receipt" },
        "receiptUrl": { "type": "string", "description": "Download or preview URL of receipt" },
        "notes": { "type": "string", "description": "Optional detailed notes" },
        "createdBy": { "type": "string", "description": "User ID who created the record" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "familyId", "amount", "currency", "categoryId", "expenseDate", "monthKey", "createdBy", "createdAt"]
    },
    "ExpenseCategory": {
      "title": "ExpenseCategory",
      "description": "Standard and custom expense categories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Category ID or slug" },
        "familyId": { "type": "string", "description": "Family ID reference" },
        "name": { "type": "string", "description": "Category display name" },
        "icon": { "type": "string", "description": "Category icon" },
        "active": { "type": "boolean", "description": "Whether category is active" },
        "isCustom": { "type": "boolean", "description": "Whether custom created" }
      },
      "required": ["id", "familyId", "name", "active"]
    },
    "FamilyBudget": {
      "title": "FamilyBudget",
      "description": "Monthly family spending budget",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Budget ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "year": { "type": "number", "description": "Budget year" },
        "month": { "type": "number", "description": "Budget month 1-12" },
        "monthKey": { "type": "string", "description": "Standard month key YYYY-MM" },
        "amount": { "type": "number", "description": "Budget target amount" },
        "currency": { "type": "string", "description": "Currency code" }
      },
      "required": ["id", "familyId", "year", "month", "monthKey", "amount", "currency"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Family household bill obligation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Bill ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "templateId": { "type": "string", "description": "Optional recurring template ID" },
        "billTypeId": { "type": "string", "description": "Bill type ID" },
        "billTypeName": { "type": "string", "description": "Type name e.g. Electricity" },
        "providerName": { "type": "string", "description": "Provider name e.g. LESCO" },
        "amount": { "type": "number", "description": "Bill amount" },
        "paidAmount": { "type": "number", "description": "Amount paid so far" },
        "remainingAmount": { "type": "number", "description": "Amount remaining" },
        "currency": { "type": "string", "description": "Currency code" },
        "dueDate": { "type": "string", "description": "Due date YYYY-MM-DD" },
        "billingMonthKey": { "type": "string", "description": "Billing month key YYYY-MM" },
        "status": { "type": "string", "description": "Status", "enum": ["Pending", "Paid", "Partially Paid", "Overdue", "Cancelled"] },
        "accountNumberMasked": { "type": "string", "description": "Masked account number" }
      },
      "required": ["id", "familyId", "billTypeId", "billTypeName", "providerName", "amount", "dueDate", "status"]
    },
    "BillTemplate": {
      "title": "BillTemplate",
      "description": "Recurring bill schedule definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Template ID" },
        "familyId": { "type": "string", "description": "Family ID" },
        "billTypeId": { "type": "string", "description": "Bill type ID" },
        "providerName": { "type": "string", "description": "Provider name" },
        "amountType": { "type": "string", "description": "fixed or variable" },
        "defaultAmount": { "type": "number", "description": "Default amount" },
        "frequency": { "type": "string", "description": "Recurrence frequency" },
        "startDate": { "type": "string", "description": "Start date" },
        "nextDueDate": { "type": "string", "description": "Next due date" },
        "active": { "type": "boolean", "description": "Active or paused status" }
      },
      "required": ["id", "familyId", "billTypeId", "providerName", "frequency", "nextDueDate", "active"]
    },
    "BillPayment": {
      "title": "BillPayment",
      "description": "Payment installment made toward a bill",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Payment ID" },
        "billId": { "type": "string", "description": "Bill ID reference" },
        "familyId": { "type": "string", "description": "Family ID reference" },
        "amount": { "type": "number", "description": "Payment amount" },
        "paymentDate": { "type": "string", "description": "Date of payment" },
        "paidByName": { "type": "string", "description": "Name of payer" },
        "paymentMethod": { "type": "string", "description": "Payment method" }
      },
      "required": ["id", "billId", "familyId", "amount", "paymentDate", "paidByName"]
    },
    "FamilyNote": {
      "title": "FamilyNote",
      "description": "Structured family note, important note, or urgent need",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Note unique ID" },
        "familyId": { "type": "string", "description": "Family reference ID" },
        "type": { "type": "string", "description": "Note type", "enum": ["general", "important", "urgent", "information"] },
        "title": { "type": "string", "description": "Note title" },
        "description": { "type": "string", "description": "Note detailed text" },
        "categoryId": { "type": "string", "description": "Category identifier" },
        "categoryName": { "type": "string", "description": "Category name" },
        "priority": { "type": "string", "description": "Priority level", "enum": ["low", "normal", "high", "urgent"] },
        "status": { "type": "string", "description": "Current status", "enum": ["pending", "in_progress", "completed", "cancelled"] },
        "dueDate": { "type": "string", "description": "Optional due calendar date (YYYY-MM-DD)" },
        "assignedToMemberId": { "type": "string", "description": "Assigned family member ID" },
        "assignedToMemberName": { "type": "string", "description": "Assigned family member name" },
        "linkedPersonId": { "type": "string", "description": "Linked member or child ID" },
        "isPinned": { "type": "boolean", "description": "Whether note is pinned to top" },
        "isArchived": { "type": "boolean", "description": "Whether note is archived" },
        "createdBy": { "type": "string", "description": "Author user ID" },
        "createdByName": { "type": "string", "description": "Author display name" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "familyId", "type", "title", "createdBy", "createdAt"]
    },
    "NoteCategory": {
      "title": "NoteCategory",
      "description": "Custom or default category for family notes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Category ID" },
        "familyId": { "type": "string", "description": "Family reference ID" },
        "name": { "type": "string", "description": "Category display name" },
        "active": { "type": "boolean", "description": "Whether category is active" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "familyId", "name", "active"]
    },
    "FamilyInformation": {
      "title": "FamilyInformation",
      "description": "Information center record (house info, emergency contact, utility, vehicle)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Information card ID" },
        "familyId": { "type": "string", "description": "Family reference ID" },
        "title": { "type": "string", "description": "Information title" },
        "value": { "type": "string", "description": "Information value / detail" },
        "category": { "type": "string", "description": "Information category" },
        "visibility": { "type": "string", "description": "Visibility scope", "enum": ["family", "admins_only"] },
        "createdBy": { "type": "string", "description": "Author user ID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "familyId", "title", "value", "category", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "/families/{familyId}/notes/{noteId}": {
      "schema": "FamilyNote",
      "description": "Family notes, important notes, and urgent needs"
    },
    "/families/{familyId}/noteCategories/{categoryId}": {
      "schema": "NoteCategory",
      "description": "Family note categories"
    },
    "/families/{familyId}/information/{informationId}": {
      "schema": "FamilyInformation",
      "description": "Family information center records"
    },
    "/families/{familyId}/bills/{billId}": {
      "schema": "Bill",
      "description": "Family bills"
    },
